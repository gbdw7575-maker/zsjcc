PORT=3000

# === 本地 MongoDB（推荐，一键启动脚本会自动管理）===
MONGODB_URI=mongodb://localhost:27017/tft_assistant

# === 也可使用 MongoDB Atlas 云端（免费）===
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tft_assistant?retryWrites=true&w=majority

JWT_SECRET=请替换为至少64字符的随机字符串
JWT_EXPIRE=7d
NODE_ENV=development

# AI 分析（DeepSeek/OpenAI/智谱）密钥：仅在服务端使用，前端通过 /api/ai 代理调用
AI_API_KEY=
AI_PROVIDER=deepseek

# Docker Compose 使用的变量（仅 docker-compose 部署时需要）
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=请修改Mongo密码
CLIENT_URL=http://localhost

# 管理员初始密码（首次启动自动创建管理员账户时使用）
ADMIN_PASSWORD=123456
